{
  "cases": [
    {
      "name": "normalize_command_strips_colon_and_lowercases",
      "raw_input": " :SUM LIST ",
      "expected_normalized": "sum list",
      "mode": "editor",
      "expected_resolved": "sum list",
      "expected_note_security": null
    },
    {
      "name": "note_encrypt_with_note_prefix",
      "raw_input": "note encrypt pass123",
      "expected_normalized": "note encrypt pass123",
      "mode": "editor",
      "expected_resolved": "note encrypt",
      "expected_note_security": {
        "action": "encrypt",
        "password": "pass123",
        "used_note_prefix": true
      }
    },
    {
      "name": "note_decrypt_alias_without_prefix",
      "raw_input": "decrypt-note p",
      "expected_normalized": "decrypt-note p",
      "mode": "editor",
      "expected_resolved": "note decrypt",
      "expected_note_security": {
        "action": "decrypt",
        "password": "p",
        "used_note_prefix": false
      }
    },
    {
      "name": "quit_is_vim_only",
      "raw_input": "q!",
      "expected_normalized": "q!",
      "mode": "editor",
      "expected_resolved": null,
      "expected_note_security": null
    },
    {
      "name": "quit_resolves_in_vim_mode",
      "raw_input": "q!",
      "expected_normalized": "q!",
      "mode": "vim",
      "expected_resolved": "q",
      "expected_note_security": null
    }
  ]
}
