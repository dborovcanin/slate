pkgname=slate-bin
pkgver=0.2.0.r0.g0000000
pkgrel=1
pkgdesc="Minimal, keyboard-first terminal note-taking scratchpad (prebuilt binary)"
arch=("x86_64")
url="https://github.com/dborovcanin/slate"
license=("custom")
depends=(
  "gcc-libs"
  "glibc"
)
provides=("slate")
conflicts=("slate" "slate-git")
source=(
  "slate-${pkgver}-linux-x86_64.tar.gz::https://github.com/dborovcanin/slate/releases/download/aur-bin/slate-${pkgver}-linux-x86_64.tar.gz"
  "slate.desktop"
)
sha256sums=(
  "REPLACE_WITH_CI_SHA256"
  "5f9574913c9693ad1b5e656211d8944a3e89ff3dc94dd17ee87bc3740acff88e"
)

package() {
  install -Dm755 "slate" "${pkgdir}/usr/bin/slate"
  install -Dm644 "${srcdir}/slate.desktop" "${pkgdir}/usr/share/applications/slate.desktop"
  install -Dm644 "slate.png" "${pkgdir}/usr/share/pixmaps/slate.png"
}
