_pkgname=slate
pkgname=${_pkgname}-git
pkgver=0.2.0.r0.g0000000
pkgrel=1
pkgdesc="Minimal, keyboard-first terminal note-taking scratchpad (git)"
arch=("x86_64")
url="https://github.com/dborovcanin/slate"
license=("custom")
depends=(
  "gcc-libs"
  "glibc"
)
makedepends=(
  "cargo"
  "git"
)
provides=("slate")
conflicts=("slate")
source=(
  "git+${url}.git"
  "slate.desktop"
)
sha256sums=(
  "SKIP"
  "5f9574913c9693ad1b5e656211d8944a3e89ff3dc94dd17ee87bc3740acff88e"
)

pkgver() {
  cd "${_pkgname}"
  local base
  base="$(sed -n 's/^version = "\(.*\)"$/\1/p' crates/tui/Cargo.toml | head -n1)"
  printf "%s.r%s.g%s" \
    "${base}" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

build() {
  cd "${_pkgname}"
  cargo build --release --locked -p slate --bin slate
}

package() {
  cd "${_pkgname}"
  install -Dm755 "target/release/slate" "${pkgdir}/usr/bin/slate"
  install -Dm644 "${srcdir}/slate.desktop" "${pkgdir}/usr/share/applications/slate.desktop"
  install -Dm644 "slate.png" "${pkgdir}/usr/share/pixmaps/slate.png"
}
