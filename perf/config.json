{
  "description": "Unified performance checks (startup + table + inline images). Global enable/disable comes from config.toml [perf].enabled.",
  "checks": {
    "startup": {
      "enabled": true,
      "runs": 3,
      "threshold_pct": 15
    },
    "table": {
      "enabled": true,
      "profile": "ci"
    },
    "images": {
      "enabled": true,
      "lines": 100000,
      "viewport_lines": 24,
      "iterations": 1000,
      "threshold_p95_ms": 5
    }
  }
}
